.page { padding: 24rpx; padding-bottom: 120rpx; }
.steps { display: flex; flex-wrap: wrap; gap: 8rpx; margin-bottom: 24rpx; }
.step { font-size: 20rpx; padding: 8rpx 12rpx; background: #f1f5f9; border-radius: 8rpx; color: #64748b; }
.step.on { background: #ffe4e6; color: #be123c; }
.card { background: #fff; border-radius: 16rpx; padding: 24rpx; }
.card input, .card textarea { width: 100%; margin-bottom: 16rpx; padding: 16rpx; border: 1px solid #e2e8f0; border-radius: 12rpx; font-size: 28rpx; box-sizing: border-box; }
.tip { font-size: 22rpx; color: #64748b; display: block; margin-bottom: 16rpx; }
.footer { position: fixed; left: 0; right: 0; bottom: 0; display: flex; gap: 16rpx; padding: 16rpx 24rpx; background: #fff; border-top: 1px solid #e2e8f0; }
.footer button { flex: 1; }
.primary { background: #e11d48; color: #fff; }
.ai-title { font-size: 28rpx; color: #0f172a; display: block; }
.ai-sub { font-size: 24rpx; color: #64748b; margin-top: 12rpx; display: block; }
