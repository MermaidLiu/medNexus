.page { padding: 48rpx 32rpx; }
.hero { margin-bottom: 48rpx; }
.title { display: block; font-size: 40rpx; font-weight: 700; color: #0f172a; }
.sub { display: block; margin-top: 12rpx; font-size: 24rpx; color: #64748b; }
.btn { margin-top: 24rpx; border-radius: 16rpx; font-size: 28rpx; }
