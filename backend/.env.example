# OpenAI-compatible LLM (optional — enables LLM-based PICO extraction)
OPENAI_API_KEY=
OPENAI_BASE_URL=http://118.195.160.99/v1
OPENAI_MODEL=gemini-2.5-flash

# ToolUniverse (optional — set true after: uv pip install tooluniverse)
TOOLUNIVERSE_ENABLED=false

# CORS
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

DEBUG=true

# Agent 版本默认授权：hospital | research | pharma
AGENT_EDITION=research
